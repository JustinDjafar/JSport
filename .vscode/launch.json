{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug JSport API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}\\src\\JSport.Api\\bin\\Debug\\net10.0\\JSport.Api.dll",
      "cwd": "${workspaceFolder}\\src\\JSport.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5237"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
