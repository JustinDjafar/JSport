# Copy to .env only if your process manager loads dotenv files.
# ASP.NET Core reads the equivalent double-underscore environment variables directly.
# Local connection through Cloud SQL Auth Proxy running on port 5433.
# Replace change-me with the jsport_app password from Secret Manager; never commit the real value.
ConnectionStrings__Postgres=Host=localhost;Port=5433;Database=jsport;Username=jsport_app;Password=change-me
Cors__AllowedOrigins__0=http://localhost:5173
Firebase__ProjectId=jsport-production

# Credentials for server-sent transactional emails such as custom password-reset links.
# Use an app-specific password, not the mailbox's normal login password.
# Keep the real values only in .env locally and in Secret Manager for production.
Email__SenderEmail=sender@example.com
Email__SenderPassword=change-me-app-password

VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=jsport-production.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jsport-production
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=jsport-production.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id

# Court prices are stored in PostgreSQL and returned by the API.
# Do not put an authoritative booking price in VITE_* variables; those are public and editable in the browser.
