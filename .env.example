# Copy to .env only if your process manager loads dotenv files.
# ASP.NET Core reads the equivalent double-underscore environment variables directly.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=jsport;Username=postgres;Password=change-me
Cors__AllowedOrigins__0=http://localhost:5173

# Court prices are stored in PostgreSQL and returned by the API.
# Do not put an authoritative booking price in VITE_* variables; those are public and editable in the browser.
